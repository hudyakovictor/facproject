# Base URL for all /api/v1/* calls (compare, calibration, jobs, settings, etc).
# Leave empty to use same-origin requests (recommended when the API is served
# behind the same reverse proxy as this UI in production).
VITE_API_BASE_URL=http://localhost:8000

# Override only the timeline endpoint specifically (rare — usually leave unset
# so it derives from VITE_API_BASE_URL + /api/v1/timeline).
# VITE_TIMELINE_API_URL=/api/v1/timeline
